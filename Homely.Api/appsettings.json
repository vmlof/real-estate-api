{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=5432;Database=HomelyDB;User Id=DB_USER;Password=DB_PASSWORD;"
  },
  "Frontend": {
    "Origin": "http://localhost:3000"
  },
  "Jwt": {
    "Issuer": "HomelyAPI",
    "Audience": "HomelyClient",
    "SecretBase64": "SECRET_BASE64",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
